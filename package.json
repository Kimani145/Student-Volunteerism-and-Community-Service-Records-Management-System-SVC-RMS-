{
  "name": "svc-rms",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "audit:verify": "node scripts/audit-verify.mjs",
    "trace:check": "node scripts/trace-check.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "e2e": "pnpm --filter @svc-rms/web e2e",
    "dev": "pnpm --filter @svc-rms/api dev & pnpm --filter @svc-rms/web dev"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "puppeteer": "^25.12.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "pnpm": {
    "overrides": {
      "fastify": ">=5.12.5"
    }
  }
}
